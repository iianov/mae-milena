{
  "name": "milena-referencias",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-29",
  "vars": { "COLLECTION_ENABLED": "false" },
  "d1_databases": [{ "binding": "DB", "database_name": "milena-referencias", "database_id": "5515460d-7f7b-4e8a-8b75-6308854a6bca" }],
  "ratelimits": [{ "name": "REFERENCE_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": false }
}
